# ============================================================
# Konfigurasi Lingkungan — SPP Digital Ar-Rahman
# Salin file ini ke .env dan sesuaikan nilainya
# ============================================================

# --- Database Lokal (Development / Offline) ---
# SQLite lokal, tidak butuh jaringan eksternal
DATABASE_URL="file:./data/ta-spp.db"
DATABASE_AUTH_TOKEN=""

# --- Deployment Produksi (Cloudflare Workers) ---
# Basis data D1 dikonfigurasi via wrangler.json (binding DB & DB_STORAGE)
# Tidak perlu DATABASE_URL saat deploy ke Cloudflare — D1 diinject otomatis
#
# Cloudflare D1:
#   Database Name : payptd
#   Database ID   : bcf1d253-7f8a-4669-b399-05d06127240f
#   Binding DB    : database utama (relasional)
#   Binding DB_STORAGE : penyimpanan bukti transfer (payment_proofs)

# --- CRON Secret (Opsional) ---
# Lindungi endpoint /api/cron/generate-spp dari akses publik
# CRON_SECRET="ganti-dengan-secret-panjang-acak"

# --- Vite API URL (Opsional, untuk dev SPA terpisah) ---
# VITE_API_URL=""
